# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Local NLP Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# Storage & Retrieval
# Leave QDRANT_LOCATION empty to use local disk storage in storage/qdrant/
# Set to ':memory:' for transient runs or provide a remote Qdrant URL (e.g., http://localhost:6333)
QDRANT_LOCATION=
QDRANT_COLLECTION=crag_gemini_docs
TOP_K_RETRIEVAL=10
TOP_K_RERANK=3
MAX_CHUNK_TOKENS=384
